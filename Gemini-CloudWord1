const allKeywordsFromOffers = new Set(offers.flatMap(o => o.associated_keywords));

function generateInitialKeywords(minOccurrences = 3) {
    const keywordOfferCount = {};
    allKeywordsFromOffers.forEach(kw => {
        keywordOfferCount[kw] = offers.filter(offer => offer.associated_keywords.includes(kw)).length;
    });

    const eligibleKeywords = Array.from(allKeywordsFromOffers).filter(kw => keywordOfferCount[kw] >= minOccurrences);
    
    const mustHaveKeywords = ['sd-wan', 'gestion de flotte', 'cybersecurity', '5g', 'internet access'];
    const selectedKeywords = new Map();

    mustHaveKeywords.forEach(kw => {
        if(eligibleKeywords.includes(kw)) {
            const personaKey = Object.keys(personas).find(p => personas[p].tags.includes(kw)) || 'it';
            selectedKeywords.set(kw, { keyword: kw, persona: personaKey });
        }
    });

    const personaOrder = ['it', 'business', 'security', 'data']; 
    for (const personaKey of personaOrder) {
        if (selectedKeywords.size >= 8) break;
        const personaTags = personas[personaKey].tags;
        const potentialKeywords = eligibleKeywords.filter(kw => personaTags.includes(kw) && !selectedKeywords.has(kw));
        
        potentialKeywords.slice(0, 2).forEach(kw => {
            if (selectedKeywords.size < 8 && !selectedKeywords.has(kw)) {
                selectedKeywords.set(kw, { keyword: kw, persona: personaKey });
            }
        });
    }

    const finalKeywords = Array.from(selectedKeywords.values());

    for (let i = finalKeywords.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [finalKeywords[i], finalKeywords[j]] = [finalKeywords[j], finalKeywords[i]];
    }
    
    return finalKeywords;
}


function getAvailableKeywords(selected, offers) {
  const filteredOffers = selected.length > 0 
    ? offers.filter(offer => selected.every(sel => offer.associated_keywords.includes(sel)))
    : offers;

  if (filteredOffers.length === 0) return [];
  
  const keywordCount = {};
  filteredOffers.forEach((offer) => {
    offer.associated_keywords.forEach((kw) => {
      if (!selected.includes(kw) && !kw.startsWith('tag_')) {
          keywordCount[kw] = (keywordCount[kw] || 0) + 1;
      }
    });
  });

  return Object.entries(keywordCount)
    .sort((a, b) => b[1] - a[1])
    .map(([kw]) => kw)
    .slice(0, 15);
}

