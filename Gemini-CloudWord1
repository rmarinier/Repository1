function parseCsv(csv) {
    const lines = csv.trim().split('\n').slice(1);
    const headers = ["Offer_ID","Offer_Name","Category_Type","Primary_Category_Name","Sub_Category_Name","Description","URL","Associated_Keywords","Partner_Name"];
    return lines.map(line => {
        const values = line.match(/(".*?"|[^",]+)(?=\s*,|\s*$)/g)?.map(val => val.replace(/^"|"$/g, '')) || [];
        const obj = {};
        headers.forEach((header, i) => {
            let key = header.toLowerCase();
            let value = values[i] || '';
            if (key === 'offer_name' || key === 'description') {
                 value = { en: value, fr: value, es: value, it: value, gr: value };
            }
            if (key === 'associated_keywords') {
                value = value.split(',').map(kw => kw.trim()).filter(Boolean);
            }
            obj[key] = value;
        });
        return obj;
    });
}

