                                                    <input type="date" required className="w-full p-2 text-sm bg-white rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-400"/>
                                                    <input type="time" required className="w-full p-2 text-sm bg-white rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-400"/>
                                                    <button type="submit" className="w-full p-2 bg-orange-500 text-white font-semibold rounded-md hover:bg-orange-600 transition-colors">{T.ui_contact_confirm_callback}</button>
                                                </motion.form>
                                            )}
                                            </AnimatePresence>
                                        </div>
                                    </motion.div>
                                );
                            case 'contact_confirmation':
                                return (
                                     <motion.div key="contact-confirm-view" initial={{opacity:0, scale: 0.95}} animate={{opacity:1, scale: 1}} exit={{opacity:0}} className="p-8 flex flex-col items-center justify-center h-full text-center">
                                        <CheckCircle className="w-16 h-16 text-green-500" />
                                        <p className="mt-4 font-semibold text-lg text-gray-800">{T.ui_contact_request_received}</p>
                                    </motion.div>
                                );
                             case 'proactive_message':
                                return proactiveTriggers[currentUrl] ? (
                                    <motion.div key="proactive-view" initial={{opacity:0, scale: 0.95}} animate={{opacity:1, scale: 1}} exit={{opacity:0}} className="p-6 text-center">
                                        <Sparkles className="w-12 h-12 mx-auto text-orange-500" />
                                        <p className="mt-4 font-semibold text-gray-800">{T[proactiveTriggers[currentUrl].messageKey]}</p>
                                        <motion.button onClick={() => setCurrentView('contact')} whileHover={{scale: 1.05}} whileTap={{scale: 0.95}} className="mt-6 w-full bg-orange-500 text-white font-bold py-2 px-4 rounded-lg shadow-lg hover:bg-orange-600 transition-colors">{T[proactiveTriggers[currentUrl].ctaKey]}</motion.button>
                                    </motion.div>
                                ) : null;
                            case 'faq':
                                return (
                                    <motion.div key="faq-view" initial={{opacity:0}} animate={{opacity:1}} exit={{opacity:0}} className="p-5 text-center">
                                         <button onClick={() => setCurrentView('initial')} className="flex items-center gap-2 text-sm text-gray-500 hover:text-gray-800 mb-4"><ArrowLeft size={16}/> Retour</button>
                                        <h2 className="text-lg font-bold text-gray-800">{T.ui_faq_title}</h2>
                                        <p className="text-sm text-gray-500 mt-1 mb-4">{T.ui_faq_subtitle}</p>
                                        <div className="space-y-2 text-left">
                                            <button className="w-full p-2 text-sm text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md transition-colors">{T.ui_faq_prompt_1}</button>
                                            <button className="w-full p-2 text-sm text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md transition-colors">{T.ui_faq_prompt_2}</button>
                                            <button className="w-full p-2 text-sm text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md transition-colors">{T.ui_faq_prompt_3}</button>
                                        </div>
                                    </motion.div>
                                );
                            default:
                                return null;
                        }
                    })()}
                  </AnimatePresence>
                </div>
                
                {/* Prompt input form */}
                <div className="p-3 mt-auto border-t border-gray-200 bg-white">
                  <form onSubmit={handlePromptSubmit} className="relative flex items-center">
                      <input type="text" name="prompt" disabled={isLoading} placeholder={T.ui_prompt_placeholder} className="w-full pl-4 pr-32 py-2 border border-gray-300 rounded-full focus:outline-none focus:ring-2 focus:ring-orange-400 transition-shadow disabled:bg-gray-100 text-sm"/>
                      <div className="absolute right-12 flex items-center">
                        <button type="button" onClick={() => setCurrentView('rfp')} className="p-2 text-gray-500 hover:text-orange-600 rounded-full" title="Analyser un document"><Paperclip className="w-5 h-5"/></button>
                        <button type="button" onClick={() => setCurrentView('contact')} className="p-2 text-gray-500 hover:text-orange-600 rounded-full" title={T.ui_contact_advisor}><Headset className="w-5 h-5"/></button>
                        <button type="button" className="p-2 text-gray-500 hover:text-orange-600 rounded-full" title="Recherche vocale"><Mic className="w-5 h-5"/></button>
                      </div>
                      <button type="submit" disabled={isLoading} className="absolute right-1 top-1/2 -translate-y-1/2 p-2 rounded-full text-white bg-orange-500 hover:bg-orange-600 disabled:bg-gray-400 transition-colors">
                          {isLoading ? <motion.div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin" /> : <Send className="w-5 h-5"/>}
                      </button>
                  </form>
                </div>
              </motion.div>

              {/* Results panel (appears when offers are filtered) */}
              <AnimatePresence>
              {showResultsPanel && (
                <motion.div 
                    initial={{ opacity: 0, x: 20 }} 
                    animate={{ opacity: 1, x: 0, transition: { delay: 0.2 } }} 
                    exit={{ opacity: 0, x: 20, transition: {duration: 0.2} }} 
                    className="flex-1 min-w-[22rem] flex flex-col border-l border-gray-200 bg-gray-50/50"
                >
                  <div className="overflow-y-auto p-4 flex-grow">
                      {filteredOffers.length > 0 ? (
                        <div className="space-y-4">
                          <p className="text-sm font-medium text-gray-600">
                            {filteredOffers.length} {filteredOffers.length > 1 ? T.ui_results_for : T.ui_result_for}
                          </p>
                            {filteredOffers.map((offer, index) => (
                                <motion.div key={offer.offer_id} initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0, transition: { delay: index * 0.1 } }} className="offer-card bg-white border border-gray-200 p-3 rounded-lg hover:shadow-lg hover:border-orange-300 transition-all duration-200 flex flex-col justify-between">
                                  <div>
                                    <a href={offer.url} target="_blank" rel="noopener noreferrer" className="font-semibold text-orange-600 hover:underline">{(T.offers && T.offers[offer.offer_id]?.name) || offer.offer_name}</a>
                                    <p className="text-sm text-gray-700 mt-1">{(T.offers && T.offers[offer.offer_id]?.desc) || offer.description}</p>
                                  </div>
                                  <button onClick={(e) => addToCart(offer, e)} className="mt-3 w-full bg-orange-100 text-orange-800 font-semibold py-1.5 px-3 rounded-md hover:bg-orange-200 transition-colors text-sm flex items-center justify-center gap-2">
                                    <PlusCircle size={16} /> {T.ui_add_to_cart}
                                  </button>
                                </motion.div>
                            ))}
                        </div>
                      ) : (
                        <div className="flex flex-col items-center justify-center h-full text-center text-gray-500 p-6">
                            <Search className="w-12 h-12 mb-4 text-gray-400" />
                            <p className="font-semibold">{T.ui_no_match}</p>
                        </div>
                      )}
                  </div>
                </motion.div>
              )}
              </AnimatePresence>
            </motion.div>
           </LayoutGroup>
          </motion.div>
        )}
        </AnimatePresence>
      </div>
    </div>
  );
}
