    ? offers.filter((offer) => selected.every((kw) => offer.associated_keywords.includes(kw)))
    : [], [selected]);
    
  const availableKeywords = useMemo(() => getAvailableKeywords(selected, offers), [selected]);

  const handleSelectKeyword = (word, personaKey) => {
    if (!selected.includes(word)) {
        if (selected.length === 0 && personaKey) {
            setActivePersonaKey(personaKey);
        }
        setSelected((prev) => {
            const newSelection = [...prev, word];
            newSelection.sort((a, b) => (T[a] || a).localeCompare(T[b] || b, language));
            return newSelection;
        });
    }
  };

  const handleDeselectKeyword = (word) => {
    setSelected((prev) => {
        const newSelected = prev.filter((kw) => kw !== word);
        if (newSelected.length === 0) {
            setActivePersonaKey(null);
        }
        return newSelected;
    });
  };
  
  const handleReset = () => {
    setSelected([]);
    setActivePersonaKey(null);
  }

  const allLanguages = ["fr", "en", "es", "it", "gr"];

  const handlePromptSubmit = async (e) => {
    e.preventDefault();
    const prompt = e.target.elements.prompt.value;
    if (!prompt) return;

    setIsLoading(true);
    await new Promise(resolve => setTimeout(resolve, 1500)); 
    
    const promptKeywords = prompt.toLowerCase().split(/\s+/);
    const extracted = Array.from(allKeywordsFromOffers).filter(kw => promptKeywords.some(pk => kw.toLowerCase().includes(pk) && pk.length > 2));
    
    handleReset();
    if(extracted.length > 0) {
      const firstKw = extracted[0];
      const personaKey = Object.keys(personas).find(p => offers.some(o => o.associated_keywords.includes(firstKw) && personas[p].tags.some(tag => o.associated_keywords.includes(tag)))) || 'business';
      setActivePersonaKey(personaKey);
      
      const sortedExtracted = extracted.sort((a, b) => (T[a] || a).localeCompare(T[b] || b, language));
      setSelected(sortedExtracted);
    }
    
    setIsLoading(false);
    e.target.elements.prompt.value = '';
  }
  
  const showResultsPanel = selected.length > 0 && filteredOffers.length > 0;

  return (
    <div className="relative min-h-screen bg-gray-50 text-gray-900 p-8 flex flex-col items-center justify-start space-y-8 font-sans">
      <div className="fixed bottom-6 right-6 z-50">
        <div className="relative flex items-center justify-center w-20 h-20">
          <div className="absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-10 animate-ping"></div>
          <div className="absolute inline-flex h-full w-full rounded-full bg-orange-300 opacity-10 animate-pulse"></div>
          <button
            onClick={() => { setChatOpen(!chatOpen); if(!chatOpen) handleReset(); }}
            className="relative z-10 bg-orange-500 hover:bg-orange-600 text-white rounded-full w-16 h-16 flex items-center justify-center shadow-xl transition-all duration-200 ease-in-out"
            aria-label="Ouvrir le menu GenAI"
          >
            {chatOpen ? <X className="w-7 h-7" /> : <MessageCircle className="w-7 h-7" />}
          </button>
        </div>
        
        <AnimatePresence>
        {chatOpen && (
          <motion.div 
            layout 
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: 20 }}
            transition={{ ease: "easeInOut", duration: 0.4 }}
            className={`absolute bottom-24 right-0 max-h-[80vh] bg-white text-gray-900 rounded-xl shadow-2xl border border-gray-200 flex flex-col`}
          >
           <LayoutGroup> 
            <motion.div layout className={`flex transition-all duration-500 ease-in-out ${showResultsPanel ? 'w-[48rem]' : 'w-[36rem]'}`}>
              {/* Colonne gauche : mots-clés */}
              <motion.div layout="position" className="flex-1 flex flex-col">
                <div className="flex justify-between items-center flex-shrink-0 p-4 border-b border-gray-200">
                  <div className="flex gap-2">
                    {allLanguages.map((lang) => (
                      <button key={lang} onClick={() => setLanguage(lang)} className={`transition-transform duration-200 ${language === lang ? 'scale-125' : 'opacity-50 hover:opacity-100 hover:scale-110'}`} title={lang}>
                         <LanguageFlag lang={lang} />
                      </button>
                    ))}
                  </div>
                  <div className="flex items-center gap-4">
                    <button onClick={handleReset} className="text-gray-500 hover:text-orange-600 transition-colors" aria-label="Réinitialiser">
                      <RotateCcw className="w-5 h-5" />
                    </button>
                    <button onClick={() => setChatOpen(false)} className="text-gray-500 hover:text-red-600 transition-colors" aria-label="Fermer">
                      <X className="w-5 h-5" />
                    </button>
                  </div>
                </div>

                <div className="overflow-y-auto">
                  <AnimatePresence mode="wait">
                    {selected.length > 0 ? (
                      <motion.div>
                        <motion.div layout className="flex flex-wrap gap-2 p-4 border-b border-gray-200 flex-shrink-0">
                           <AnimatePresence>
                           {selected.map(word => {
                                   const personaKeyForColor = Object.keys(personas).find(p => personas[p].tags.includes(word)) || activePersonaKey || 'business';
                                   const color = personas[personaKeyForColor]?.color || personas.business.color;
                                   return(
                                 <motion.button 
                                      layoutId={`kw-${word}`}
                                      key={word}
                                      onClick={() => handleDeselectKeyword(word)}
                                      className={`flex items-center gap-1.5 text-sm px-3 py-1 rounded-full text-white ${color.selectedBg} hover:bg-red-500 transition-colors`}
                                      title={`Retirer '${T[word] || word}'`}
                                 >
                                     {T[word] || word} <X className="w-3 h-3" />
                                 </motion.button>
                             )})}
                             </AnimatePresence>
                         </motion.div>
                         <div className="p-4">
                             { (filteredOffers.length > 1 && availableKeywords.length > 0) && <h3 className="font-bold text-sm mb-3 text-gray-500">{T.ui_refine_search}</h3> }
                             <div className="flex flex-wrap gap-2">
                                 {filteredOffers.length > 1 && availableKeywords.map((word, index) => (
                                     <motion.button
                                         key={word}
                                         initial={{ opacity: 0, y: 10 }}
                                         animate={{ opacity: 1, y: 0, transition: { delay: index * 0.05 } }}
                                         onClick={() => handleSelectKeyword(word)}
                                         className={`text-sm px-3 py-1 rounded-full border ${personas[activePersonaKey]?.color.bg} ${personas[activePersonaKey]?.color.text} ${personas[activePersonaKey]?.color.border} flex items-center gap-1`}
                                     >
                                         {T[word] || word}
                                     </motion.button>
                                 ))}
                             </div>
                         </div>
                      </motion.div>
                    ) : (
                      <motion.div 
                          key="initial-view"
                          initial={{ opacity: 0 }}
                          animate={{ opacity: 1 }}
                          exit={{ opacity: 0 }}
                          className="p-6 flex flex-col items-center justify-center"
                      >
                          <div className="flex flex-wrap justify-center gap-2">
                               {initialKeywords.map(({keyword, persona}, index) => (
                                  <motion.button 
                                      key={keyword}
                                      layoutId={`kw-${keyword}`} 
                                      initial={{ opacity: 0, y: 10 }}
                                      animate={{ opacity: 1, y: 0, transition: { delay: index * 0.05 } }}
                                      whileHover={{ scale: 1.05 }}
                                      whileTap={{ scale: 0.95 }}
                                      onClick={() => handleSelectKeyword(keyword, persona)} 
                                      className={`text-xs px-2.5 py-1 rounded-full border ${personas[persona].color.bg} ${personas[persona].color.text} ${personas[persona].color.border} flex items-center gap-1.5`}
                                  >
                                      <Sparkles className={`w-3 h-3 ${personas[persona].color.text}`} /> {T[keyword] || keyword}
                                  </motion.button>
                              ))}
                          </div>
                      </motion.div>
                    )}
                  </AnimatePresence>
                </div>
                
                <AnimatePresence>
                {selected.length > 0 && (
                    <motion.div
                        className="p-4 mt-auto border-t border-gray-200"
                        initial={{ opacity: 0, y: 10 }}
                        animate={{ opacity: 1, y: 0, transition: {delay: 0.3} }}
                        exit={{ opacity: 0 }}
                    >
                        <form onSubmit={handlePromptSubmit} className="relative">
                            <input
                             type="text"
                             name="prompt"
                             disabled={isLoading}
                             placeholder={T.ui_prompt_placeholder}
                             className="w-full pl-4 pr-10 py-2 border border-gray-300 rounded-full focus:outline-none focus:ring-2 focus:ring-orange-400 transition-shadow"
                            />
                            <button type="submit" disabled={isLoading} className="absolute right-2 top-1/2 -translate-y-1/2 p-2 rounded-full text-white bg-orange-500 hover:bg-orange-600 disabled:bg-gray-400">
                               {isLoading ? <motion.div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin" /> : <Send className="w-5 h-5"/>}
                            </button>
                        </form>
                    </motion.div>
                )}
                </AnimatePresence>

              </motion.div>

              {/* Colonne droite : résultats */}
              <AnimatePresence>
              {showResultsPanel && (
                <motion.div 
                    initial={{ opacity: 0, x: 20 }}
                    animate={{ opacity: 1, x: 0, transition: { delay: 0.3 } }}
                    exit={{ opacity: 0, x: 20 }}
                    className="flex-1 min-w-[22rem] p-4 overflow-y-auto border-l border-gray-200 bg-gray-50/50"
                >
                  <div className="space-y-4">
                    <p className="text-sm font-medium">
                      {filteredOffers.length} {filteredOffers.length > 1 ? T.ui_results_for : T.ui_result_for}
                    </p>
                      {filteredOffers.map((offer, index) => (
                        <motion.a
                          key={offer.offer_id}
                          initial={{ opacity: 0, y: 10 }}
                          animate={{ opacity: 1, y: 0, transition: { delay: index * 0.1 } }}
                          href={offer.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="block border border-gray-200 p-3 rounded-lg hover:bg-white hover:shadow-lg"
                        >
                          <p className={`font-semibold ${personas[activePersonaKey]?.color?.text || 'text-gray-600'} underline`}>{offer.offer_name[language] || offer.offer_name.en}</p>
                          <p className="text-sm text-gray-700 mt-1">
                            {offer.description[language] || offer.description.en}
                          </p>
                        </motion.a>
                      ))
                    }
                  </div>
                </motion.div>
              )}
              </AnimatePresence>
            </motion.div>
           </LayoutGroup>
          </motion.div>
        )}
        </AnimatePresence>
      </div>
    </div>
  );
}
