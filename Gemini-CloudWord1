const keywordOfferCount = {};
allKeywordsFromOffers.forEach(kw => {
    keywordOfferCount[kw] = offers.filter(offer => offer.associated_keywords.includes(kw)).length;
});

function getInitialKeywords() {
    let initialKeywords = [];
    Object.entries(personas).forEach(([personaKey, personaData]) => {
        const personaOffers = offers.filter(offer => personaData.tags.some(tag => offer.associated_keywords.includes(tag)));
        const keywordCount = {};
        personaOffers.forEach(offer => {
            offer.associated_keywords.forEach(kw => {
                if (!kw.startsWith('tag_')) {
                    keywordCount[kw] = (keywordCount[kw] || 0) + 1;
                }
            });
        });
        const topKeywords = Object.entries(keywordCount)
            .sort((a,b) => b[1] - a[1])
            .filter(([kw]) => keywordOfferCount[kw] > 1) 
            .slice(0, 5)
            .map(([kw]) => ({ keyword: kw, persona: personaKey }));
        initialKeywords.push(...topKeywords);
    });
    for (let i = initialKeywords.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [initialKeywords[i], initialKeywords[j]] = [initialKeywords[j], initialKeywords[i]];
    }
    const uniqueKeywords = new Map();
    initialKeywords.forEach(item => {
        if (!uniqueKeywords.has(item.keyword)) {
            uniqueKeywords.set(item.keyword, item);
        }
    });
    return Array.from(uniqueKeywords.values());
}

function getAvailableKeywords(selected, offers) {
  const filteredOffers = selected.length > 0 
    ? offers.filter(offer => selected.every(sel => offer.associated_keywords.includes(sel)))
    : offers;

  if (filteredOffers.length === 0) return [];
  
  const keywordCount = {};
  filteredOffers.forEach((offer) => {
    offer.associated_keywords.forEach((kw) => {
      if (!selected.includes(kw) && !kw.startsWith('tag_')) {
          keywordCount[kw] = (keywordCount[kw] || 0) + 1;
      }
    });
  });

  return Object.entries(keywordCount)
    .sort((a, b) => b[1] - a[1])
    .map(([kw]) => kw)
    .slice(0, 15);
}


