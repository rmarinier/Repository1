// Version robuste : suggestions de mots-clés + feedback UX + navigation affinée + bugfixes
import React, { useState } from "react";
import { Sparkles, MessageCircle, X, RotateCcw } from "lucide-react";

// (La constante offers = tout le tableau Excel multilingue...)
const offers = [
  // ... Coller toutes les offres ici ...
];

function getAvailableKeywords(selected, offers) {
  // 1. Si aucun mot clé sélectionné, top keywords globaux (hors tags inutiles)
  if (selected.length === 0) {
    const keywordCount = {};
    offers.forEach((offer) => {
      offer.keywords.forEach((kw) => {
        if (kw.startsWith("tag_")) return; // On ne propose pas les tags d’intention en premier
        keywordCount[kw] = (keywordCount[kw] || 0) + 1;
      });
    });
    return Object.entries(keywordCount)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 25)
      .map(([kw]) => kw);
  } else {
    // 2. Avec sélection : mots-clés présents dans TOUTES les offres filtrées et non sélectionnés
    const filteredOffers = offers.filter((offer) => selected.every((sel) => offer.keywords.includes(sel)));
    if (filteredOffers.length === 0) return [];
    // Les mots clefs qui apparaissent dans toutes les offres filtrées
    const keywordCount = {};
    filteredOffers.forEach((offer) => {
      offer.keywords.forEach((kw) => {
        if (!selected.includes(kw) && !kw.startsWith("tag_")) keywordCount[kw] = (keywordCount[kw] || 0) + 1;
      });
    });
    // Ordre par fréquence, n'affiche pas les keywords déjà sélectionnés
    return Object.entries(keywordCount)
      .sort((a, b) => b[1] - a[1])
      .map(([kw]) => kw);
  }
}

export default function GenAIAgentUXInteractiveMenu() {
  const [selected, setSelected] = useState([]);
  const [chatOpen, setChatOpen] = useState(false);
  const [language, setLanguage] = useState("fr");

  const availableKeywords = getAvailableKeywords(selected, offers);
  const filteredOffers = selected.length
    ? offers.filter((offer) => selected.every((kw) => offer.keywords.includes(kw)))
    : [];

  const handleClick = (word) => {
    if (!selected.includes(word)) setSelected((prev) => [...prev, word]);
  };
  const handleReset = () => setSelected([]);

  return (
    <div className="relative min-h-screen bg-white text-gray-900 p-8 flex flex-col items-center justify-start space-y-8 transition-all duration-300 ease-in-out">
      <h1 className="text-3xl font-bold text-center flex items-center gap-2">
        <Sparkles className="w-6 h-6 text-orange-500 animate-pulse" /> Agent GenAI — Menu interactif IA
      </h1>
      <div className="fixed bottom-6 right-6 z-50">
        <div className="relative flex items-center justify-center w-20 h-20">
          <div className="absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-10 animate-ping"></div>
          <div className="absolute inline-flex h-full w-full rounded-full bg-orange-300 opacity-10 animate-pulse"></div>
          <button
            onClick={() => setChatOpen(!chatOpen)}
            className="relative z-10 bg-orange-500 hover:bg-orange-400 text-white rounded-full w-16 h-16 flex items-center justify-center shadow-xl transition-all duration-200 ease-in-out"
            aria-label="Ouvrir le menu GenAI"
          >
            <MessageCircle className="w-7 h-7" />
          </button>
        </div>
        {chatOpen && (
          <div className={`absolute bottom-24 right-0 ${selected.length > 0 ? "w-[48rem] flex-row" : "w-96 flex-col"} max-h-[80vh] overflow-hidden bg-white text-gray-900 rounded-xl shadow-2xl border border-orange-200 transition-all duration-500 ease-in-out flex`}>
            {/* Colonne gauche : mots-clés */}
            <div className="flex-1 min-w-[18rem] max-w-[22rem] border-r border-gray-200 p-4 flex flex-col">
              <div className="flex justify-between items-center mb-2">
                <div className="flex gap-1">
                  {["fr", "en", "es", "it", "gr"].map((lang) => (
                    <button key={lang} onClick={() => setLanguage(lang)} className={language === lang ? "font-bold" : "text-gray-400"}>
                      {lang === "fr" && "🇫🇷"}
                      {lang === "en" && "🇬🇧"}
                      {lang === "es" && "🇪🇸"}
                      {lang === "it" && "🇮🇹"}
                      {lang === "gr" && "🇬🇷"}
                    </button>
                  ))}
                </div>
                <div className="flex items-center gap-2">
                  <button
                    onClick={handleReset}
                    className="text-orange-500 hover:text-orange-700 transition-colors"
                    aria-label="Réinitialiser"
                  >
                    <RotateCcw className="w-4 h-4" />
                  </button>
                  <button
                    onClick={() => setChatOpen(false)}
                    className="text-gray-500 hover:text-gray-700 transition-colors"
                    aria-label="Fermer"
                  >
                    <X className="w-4 h-4" />
                  </button>
                </div>
              </div>
              <div className="flex flex-wrap gap-2">
                {availableKeywords.length === 0 ? (
                  <p className="text-gray-400 text-sm">Aucun mot-clé disponible pour affiner davantage. Essayez de retirer un mot-clé ou réinitialisez.</p>
                ) : (
                  availableKeywords.map((word, index) => (
                    <button
                      key={index}
                      onClick={() => handleClick(word)}
                      className="text-sm px-3 py-1 rounded-full border border-orange-500 bg-orange-50 text-orange-800 hover:bg-orange-100 flex items-center gap-1 transition-all duration-200 ease-in-out"
                    >
                      <Sparkles className="w-3 h-3 text-orange-500" /> {word}
                    </button>
                  ))
                )}
              </div>
            </div>
            {/* Colonne droite : résultats */}
            {selected.length > 0 && (
              <div className="flex-1 min-w-[22rem] max-w-[26rem] p-4 overflow-y-auto border-l border-orange-100 bg-orange-50/30 animate-fade-in">
                <div className="space-y-4">
                  <p className="text-sm font-medium">
                    Résultats pour : <span className="font-bold">{selected.join(", ")}</span>
                  </p>
                  {filteredOffers.length === 0 ? (
                    <p className="text-gray-400">Aucune offre ne correspond à cette sélection. Essayez d’en retirer pour élargir la recherche.</p>
                  ) : (
                    filteredOffers.map((offer, j) => (
                      <a
                        key={j}
                        href={offer.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="block border border-orange-100 p-3 rounded-md hover:bg-orange-100 hover:shadow-md hover:scale-[1.02] transition-all duration-300 ease-in-out"
                      >
                        <p className="font-semibold text-orange-700 underline">{offer.name}</p>
                        <p className="text-sm text-gray-700 mt-1">
                          {offer.description[language] || offer.description.en}
                        </p>
                        <p className="text-xs text-gray-400 mt-1 italic">
                          {offer.primary_category_name} — {offer.sub_category_name}
                        </p>
                      </a>
                    ))
                  )}
                </div>
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
